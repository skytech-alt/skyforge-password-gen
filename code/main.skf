// skyforge-password-gen
функция сгенерировать(длина) {
    пусть алфавит = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
    пусть результат = ""
    для i от 1 до длина {
        пусть индекс = (время_сейчас() + i * 7) % длина(алфавит)
        результат = результат + алфавит[индекс]
    }
    вернуть результат
}
